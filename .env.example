# Base URL used by the browser. Prefer a same-origin path so the SPA and API
# share a host and cookies/CSP can be applied consistently.
# Default when empty: /api/v1
VITE_API_BASE_URL=/api/v1

# Request timeout in milliseconds (1000 - 120000). Default: 15000
VITE_API_TIMEOUT_MS=15000

# Enables visible "demo" banners and simulated screens.
# Default: true during `vite dev`, false in production builds.
VITE_DEMO_MODE=false

# Dev-server proxy target for /api requests (server-side only, not shipped).
VITE_DEV_API_PROXY=http://localhost:3001

import React, { useMemo, useState } from 'react';
import {
  AlertTriangle,
  ArrowDownUp,
  Boxes,
  CalendarClock,
  Check,
  CircleDollarSign,
  Download,
  FileSpreadsheet,
  Info,
  PackageCheck,
  Pencil,
  Plus,
  RefreshCw,
  Search,
  SlidersHorizontal,
  Sparkles,
  Trash2,
  TrendingUp,
} from 'lucide-react';

import {
  Pharmacy,
  PharmacyStockItem,
  ProductItem,
} from '../types';

import { MeResponse } from '../api/auth';

import {
  createInventoryItem,
  CreateStockItemPayload,
  deleteInventoryItem,
  downloadInventoryImportTemplate,
  importInventoryExcel,
  updateInventoryItem,
  UpdateStockItemPayload,
} from '../api/inventory';

interface InventoryManagerProps {
  stockItems: PharmacyStockItem[];
  activePharmacy: Pharmacy;
  pharmacies: Pharmacy[];
  currentUser: MeResponse;
  products: ProductItem[];
  onAddStockItem: (item: PharmacyStockItem) => void;
  onUpdateStockItem: (item: PharmacyStockItem) => void;
  onDeleteStockItem: (id: string) => void;
  onPushToExchange: (item: PharmacyStockItem) => void;
  onPharmacyChange: (pharmacy: Pharmacy) => void;
  onRefreshInventory: (
    pharmacyId?: string,
  ) => Promise<void>;
}

type RiskFilter =
  | 'all'
  | 'critical'
  | 'warning'
  | 'optimal'
  | 'low_stock';

type StockFilter =
  | 'all'
  | 'available'
  | 'low'
  | 'empty';

type ExpiryFilter =
  | 'all'
  | 'lt30'
  | '30to90'
  | 'gt90';

type SortField =
  | 'name'
  | 'stock'
  | 'available'
  | 'velocity'
  | 'coverage'
  | 'expiry'
  | 'value';

type SortDirection = 'asc' | 'desc';

interface FormState {
  productId: string;
  batchNumber: string;
  expiryDate: string;
  currentStock: number;
  dailySalesVelocity: number;
  originalCost: number;
  sellingPrice: number;
  minAcceptablePriceB2B: number;
}

function toDateInputValue(value: string) {
  return value.slice(0, 10);
}

function createEmptyForm(
  products: ProductItem[],
): FormState {
  const product = products[0];

  return {
    productId: product?.id ?? '',
    batchNumber: '',
    expiryDate: '',
    currentStock: 1,
    dailySalesVelocity: 0,
    originalCost: 0,
    sellingPrice: product?.basePrice ?? 0,
    minAcceptablePriceB2B: 0,
  };
}

function MetricCard({
  icon,
  label,
  value,
  tone,
  suffix = '',
  decimals = false,
}: {
  icon: React.ReactNode;
  label: string;
  value: number | string;
  tone: 'slate' | 'emerald' | 'blue' | 'amber' | 'violet';
  suffix?: string;
  decimals?: boolean;
}) {
  const tones = {
    slate:
      'border-slate-200 bg-white text-slate-700',
    emerald:
      'border-emerald-200 bg-emerald-50/60 text-emerald-700',
    blue:
      'border-blue-200 bg-blue-50/60 text-blue-700',
    amber:
      'border-amber-200 bg-amber-50/60 text-amber-700',
    violet:
      'border-violet-200 bg-violet-50/60 text-violet-700',
  };

  const displayValue =
    typeof value === 'number'
      ? new Intl.NumberFormat('fa-IR', {
          maximumFractionDigits: decimals ? 1 : 0,
        }).format(value)
      : value;

  return (
    <div
      className={`rounded-2xl border p-4 shadow-sm ${tones[tone]}`}
    >
      <div className="flex items-center justify-between">
        <span className="text-[11px] font-bold opacity-70">
          {label}
        </span>

        <span className="opacity-80">
          {icon}
        </span>
      </div>

      <div className="mt-2 truncate text-xl font-black">
        {displayValue}
        {suffix && (
          <span className="mr-1 text-[10px] font-bold opacity-60">
            {suffix}
          </span>
        )}
      </div>
    </div>
  );
}

function RiskSummary({
  label,
  value,
  className,
}: {
  label: string;
  value: number;
  className: string;
}) {
  return (
    <div
      className={`rounded-xl border p-3 shadow-sm ${className}`}
    >
      <span className="text-[10px] font-bold">
        {label}
      </span>

      <span className="mt-1 block text-lg font-black">
        {new Intl.NumberFormat('fa-IR').format(value)}
      </span>
    </div>
  );
}

function FilterSelect({
  label,
  value,
  onChange,
  options,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  options: Array<[string, string]>;
}) {
  return (
    <label className="block">
      <span className="mb-1.5 block text-[10px] font-bold text-slate-400">
        {label}
      </span>

      <select
        value={value}
        onChange={(event) =>
          onChange(event.target.value)
        }
        className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-bold text-slate-700 outline-none focus:border-medical-500 focus:ring-2 focus:ring-medical-100"
      >
        {options.map(([optionValue, optionLabel]) => (
          <option
            key={optionValue}
            value={optionValue}
          >
            {optionLabel}
          </option>
        ))}
      </select>
    </label>
  );
}

function SortableHeader({
  label,
  onClick,
}: {
  label: string;
  onClick: () => void;
}) {
  return (
    <th className="px-3 py-3">
      <button
        type="button"
        onClick={onClick}
        className="inline-flex items-center gap-1 font-bold text-slate-500 transition hover:text-emerald-700"
      >
        {label}
        <ArrowDownUp className="h-3 w-3 opacity-50" />
      </button>
    </th>
  );
}

export const InventoryManager: React.FC<
  InventoryManagerProps
> = ({
  stockItems,
  activePharmacy,
  pharmacies,
  currentUser,
  products,
  onAddStockItem,
  onUpdateStockItem,
  onDeleteStockItem,
  onPushToExchange,
  onPharmacyChange,
  onRefreshInventory,
}) => {
  const canManageInventory =
    currentUser.role === 'SUPER_ADMIN' ||
    currentUser.role === 'PHARMACY_OWNER';

  const canSelectPharmacy =
    currentUser.role === 'SUPER_ADMIN' ||
    currentUser.role === 'PLATFORM_ADMIN';

  const [filterRisk, setFilterRisk] =
    useState<RiskFilter>('all');

  const [searchQuery, setSearchQuery] =
    useState('');

  const [filterCategory, setFilterCategory] =
    useState('all');

  const [filterStock, setFilterStock] =
    useState<StockFilter>('all');

  const [filterExpiry, setFilterExpiry] =
    useState<ExpiryFilter>('all');

  const [sortField, setSortField] =
    useState<SortField>('name');

  const [sortDirection, setSortDirection] =
    useState<SortDirection>('asc');

  const [showAdvancedFilters, setShowAdvancedFilters] =
    useState(false);

  const [showModal, setShowModal] =
    useState(false);

  const [editingItem, setEditingItem] =
    useState<PharmacyStockItem | null>(null);

  const [form, setForm] = useState<FormState>(
    () => createEmptyForm(products),
  );

  const [saving, setSaving] =
    useState(false);

  const [deletingId, setDeletingId] =
    useState<string | null>(null);

  const [pushedId, setPushedId] =
    useState<string | null>(null);

  const [importingExcel, setImportingExcel] =
    useState(false);

  const [downloadingTemplate, setDownloadingTemplate] =
    useState(false);

  const [importInputKey, setImportInputKey] =
    useState(0);

  const [error, setError] =
    useState<string | null>(null);

  const [success, setSuccess] =
    useState<string | null>(null);

  const inventoryMetrics = useMemo(() => {
    const totalUnits = stockItems.reduce(
      (sum, item) => sum + item.currentStock,
      0,
    );

    const reservedUnits = stockItems.reduce(
      (sum, item) => sum + item.reservedStock,
      0,
    );

    const availableUnits = stockItems.reduce(
      (sum, item) =>
        sum +
        Math.max(
          0,
          item.currentStock - item.reservedStock,
        ),
      0,
    );

    const dailyVelocity = stockItems.reduce(
      (sum, item) =>
        sum + item.dailySalesVelocity,
      0,
    );

    const inventoryValue = stockItems.reduce(
      (sum, item) =>
        sum +
        item.currentStock * item.originalCost,
      0,
    );

    return {
      itemCount: stockItems.length,
      totalUnits,
      reservedUnits,
      availableUnits,
      dailyVelocity,
      inventoryValue,
      critical: stockItems.filter(
        (item) => item.riskLevel === 'critical',
      ).length,
      warning: stockItems.filter(
        (item) => item.riskLevel === 'warning',
      ).length,
      lowStock: stockItems.filter(
        (item) => item.riskLevel === 'low_stock',
      ).length,
    };
  }, [stockItems]);

  const filteredItems = useMemo(() => {
    const query = searchQuery.trim().toLowerCase();

    const result = stockItems.filter((item) => {
      const available = Math.max(
        0,
        item.currentStock - item.reservedStock,
      );

      const matchesSearch =
        !query ||
        [
          item.product.name,
          item.product.genericName,
          item.product.brand,
          item.product.ircCode,
          item.product.gtin,
          item.batchNumber,
        ]
          .join(' ')
          .toLowerCase()
          .includes(query);

      const matchesRisk =
        filterRisk === 'all' ||
        item.riskLevel === filterRisk;

      const matchesCategory =
        filterCategory === 'all' ||
        item.product.category === filterCategory;

      const matchesStock =
        filterStock === 'all' ||
        (filterStock === 'available' &&
          available > 0) ||
        (filterStock === 'low' &&
          item.currentStock > 0 &&
          item.currentStock <= 10) ||
        (filterStock === 'empty' &&
          item.currentStock <= 0);

      const matchesExpiry =
        filterExpiry === 'all' ||
        (filterExpiry === 'lt30' &&
          item.daysToExpiry < 30) ||
        (filterExpiry === '30to90' &&
          item.daysToExpiry >= 30 &&
          item.daysToExpiry <= 90) ||
        (filterExpiry === 'gt90' &&
          item.daysToExpiry > 90);

      return (
        matchesSearch &&
        matchesRisk &&
        matchesCategory &&
        matchesStock &&
        matchesExpiry
      );
    });

    result.sort((a, b) => {
      let left: string | number;
      let right: string | number;

      switch (sortField) {
        case 'stock':
          left = a.currentStock;
          right = b.currentStock;
          break;

        case 'available':
          left = Math.max(
            0,
            a.currentStock - a.reservedStock,
          );
          right = Math.max(
            0,
            b.currentStock - b.reservedStock,
          );
          break;

        case 'velocity':
          left = a.dailySalesVelocity;
          right = b.dailySalesVelocity;
          break;

        case 'coverage':
          left =
            a.daysOfInventoryLeft ?? -1;
          right =
            b.daysOfInventoryLeft ?? -1;
          break;

        case 'expiry':
          left = a.daysToExpiry;
          right = b.daysToExpiry;
          break;

        case 'value':
          left =
            a.currentStock * a.originalCost;
          right =
            b.currentStock * b.originalCost;
          break;

        case 'name':
        default:
          left = a.product.name;
          right = b.product.name;
          break;
      }

      if (
        typeof left === 'string' &&
        typeof right === 'string'
      ) {
        const comparison =
          left.localeCompare(
            right,
            'fa',
            { sensitivity: 'base' },
          );

        return sortDirection === 'asc'
          ? comparison
          : -comparison;
      }

      const comparison =
        Number(left) - Number(right);

      return sortDirection === 'asc'
        ? comparison
        : -comparison;
    });

    return result;
  }, [
    stockItems,
    searchQuery,
    filterRisk,
    filterCategory,
    filterStock,
    filterExpiry,
    sortField,
    sortDirection,
  ]);

  const hasActiveFilters =
    Boolean(searchQuery.trim()) ||
    filterRisk !== 'all' ||
    filterCategory !== 'all' ||
    filterStock !== 'all' ||
    filterExpiry !== 'all';

  const categoryLabels: Record<string, string> = {
    supplement: 'مکمل',
    cosmetic: 'آرایشی',
    otc_health: 'OTC / سلامت',
    sports_nutrition: 'تغذیه ورزشی',
  };

  function formatMoney(value: number) {
    return new Intl.NumberFormat('fa-IR').format(
      Math.round(value),
    );
  }

  function resetInventoryFilters() {
    setSearchQuery('');
    setFilterRisk('all');
    setFilterCategory('all');
    setFilterStock('all');
    setFilterExpiry('all');
    setSortField('name');
    setSortDirection('asc');
  }

  function toggleSort(field: SortField) {
    if (sortField === field) {
      setSortDirection((current) =>
        current === 'asc' ? 'desc' : 'asc',
      );
      return;
    }

    setSortField(field);
    setSortDirection('asc');
  }


  function resetForm() {
    setForm(createEmptyForm(products));
  }

  function openCreateModal() {
    if (!canManageInventory) return;

    setEditingItem(null);
    resetForm();
    setError(null);
    setSuccess(null);
    setShowModal(true);
  }

  function openEditModal(item: PharmacyStockItem) {
    if (!canManageInventory) return;

    setEditingItem(item);

    setForm({
      productId: item.productId,
      batchNumber: item.batchNumber,
      expiryDate: toDateInputValue(
        item.expiryDate,
      ),
      currentStock: item.currentStock,
      dailySalesVelocity:
        item.dailySalesVelocity,
      originalCost: item.originalCost,
      sellingPrice: item.sellingPrice,
      minAcceptablePriceB2B:
        item.minAcceptablePriceB2B,
    });

    setError(null);
    setSuccess(null);
    setShowModal(true);
  }

  function closeModal() {
    if (saving) return;

    setShowModal(false);
    setEditingItem(null);
    setError(null);
  }

  function updateForm(
    patch: Partial<FormState>,
  ) {
    setForm((current) => ({
      ...current,
      ...patch,
    }));
  }

  async function handleSubmit(
    event: React.FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    if (!form.productId) {
      setError('لطفاً محصول را انتخاب کنید.');
      return;
    }

    if (!form.batchNumber.trim()) {
      setError('شماره بچ الزامی است.');
      return;
    }

    if (!form.expiryDate) {
      setError('تاریخ انقضا الزامی است.');
      return;
    }

    if (form.currentStock < 0) {
      setError('موجودی نمی‌تواند منفی باشد.');
      return;
    }

    if (
      form.dailySalesVelocity < 0 ||
      form.originalCost < 0 ||
      form.sellingPrice < 0 ||
      form.minAcceptablePriceB2B < 0
    ) {
      setError(
        'مقادیر عددی نمی‌توانند منفی باشند.',
      );
      return;
    }

    setSaving(true);
    setError(null);
    setSuccess(null);

    try {
      if (editingItem) {
        const payload: UpdateStockItemPayload = {
          batchNumber:
            form.batchNumber.trim(),
          expiryDate: form.expiryDate,
          currentStock:
            form.currentStock,
          dailySalesVelocity:
            form.dailySalesVelocity,
          originalCost:
            form.originalCost,
          sellingPrice:
            form.sellingPrice,
          minAcceptablePriceB2B:
            form.minAcceptablePriceB2B,
        };

        const updated =
          await updateInventoryItem(
            editingItem.id,
            payload,
          );

        onUpdateStockItem(updated);

        setSuccess(
          'موجودی با موفقیت ویرایش شد.',
        );
      } else {
        const payload: CreateStockItemPayload = {
          productId: form.productId,
          batchNumber:
            form.batchNumber.trim(),
          expiryDate: form.expiryDate,
          currentStock:
            form.currentStock,
          dailySalesVelocity:
            form.dailySalesVelocity,
          originalCost:
            form.originalCost,
          sellingPrice:
            form.sellingPrice,
          minAcceptablePriceB2B:
            form.minAcceptablePriceB2B,
        };

        if (
          currentUser.role === 'SUPER_ADMIN' ||
          currentUser.role === 'PLATFORM_ADMIN'
        ) {
          payload.pharmacyId =
            activePharmacy.id;
        }

        const created =
          await createInventoryItem(
            payload,
          );

        onAddStockItem(created);

        setSuccess(
          'بچ جدید با موفقیت در موجودی ثبت شد.',
        );
      }

      setShowModal(false);
      setEditingItem(null);
      resetForm();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : editingItem
            ? 'ویرایش موجودی انجام نشد.'
            : 'ثبت موجودی انجام نشد.',
      );
    } finally {
      setSaving(false);
    }
  }

  async function handleDelete(
    item: PharmacyStockItem,
  ) {
    if (!canManageInventory) return;

    const confirmed = window.confirm(
      `آیا از حذف موجودی «${item.product.name}» با بچ ${item.batchNumber} مطمئن هستید؟`,
    );

    if (!confirmed) return;

    setDeletingId(item.id);
    setError(null);
    setSuccess(null);

    try {
      await deleteInventoryItem(item.id);

      onDeleteStockItem(item.id);

      setSuccess(
        'قلم موجودی با موفقیت حذف شد.',
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : 'حذف موجودی انجام نشد.',
      );
    } finally {
      setDeletingId(null);
    }
  }

  async function handleDownloadTemplate() {
    if (!canManageInventory) return;

    setDownloadingTemplate(true);
    setError(null);
    setSuccess(null);

    try {
      const blob =
        await downloadInventoryImportTemplate();

      const url = window.URL.createObjectURL(blob);
      const anchor =
        document.createElement('a');

      anchor.href = url;
      anchor.download =
        'phurmacy-inventory-template.xlsx';

      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();

      window.URL.revokeObjectURL(url);

      setSuccess(
        'نمونه Excel با موفقیت دانلود شد.',
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : 'دانلود نمونه Excel انجام نشد.',
      );
    } finally {
      setDownloadingTemplate(false);
    }
  }

  async function handleExcelImport(
    event: React.ChangeEvent<HTMLInputElement>,
  ) {
    const file = event.target.files?.[0];

    event.target.value = '';

    if (!file) return;

    if (!canManageInventory) return;

    setImportingExcel(true);
    setError(null);
    setSuccess(null);

    try {
      if (
        !file.name
          .toLowerCase()
          .endsWith('.xlsx')
      ) {
        throw new Error(
          'فقط فایل Excel با پسوند .xlsx قابل import است.',
        );
      }

      if (
        file.size >
        5 * 1024 * 1024
      ) {
        throw new Error(
          'حجم فایل نباید بیشتر از 5 مگابایت باشد.',
        );
      }

      const result =
        await importInventoryExcel(
          file,
          canSelectPharmacy
            ? activePharmacy.id
            : undefined,
        );

      await onRefreshInventory(
        activePharmacy.id,
      );

      setSuccess(
        `${result.imported} قلم از ${result.totalRows} ردیف Excel با موفقیت وارد شد.`,
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : 'Import فایل Excel انجام نشد.',
      );

      setImportInputKey(
        (current) => current + 1,
      );
    } finally {
      setImportingExcel(false);
    }
  }

  function handlePush(
    item: PharmacyStockItem,
  ) {
    onPushToExchange(item);
    setPushedId(item.id);

    window.setTimeout(() => {
      setPushedId(null);
    }, 2500);
  }

  return (
    <div
      className="space-y-6 pb-12"
      id="inventory-manager-view"
      dir="rtl"
    >
      {/* Header */}
      <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <div className="flex items-center gap-2">
            <Boxes className="h-6 w-6 text-emerald-600" />

            <h1 className="text-2xl font-black text-slate-900">
              مدیریت موجودی
            </h1>
          </div>

          <p className="mt-2 text-sm text-slate-500">
            موجودی واقعی ثبت‌شده در Backend داروخانه
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          {canSelectPharmacy && (
            <select
              value={activePharmacy.id}
              onChange={(event) => {
                const pharmacy =
                  pharmacies.find(
                    (item) =>
                      item.id ===
                      event.target.value,
                  );

                if (pharmacy) {
                  onPharmacyChange(pharmacy);
                }
              }}
              className="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 outline-none focus:border-medical-500"
            >
              {pharmacies.map((pharmacy) => (
                <option
                  key={pharmacy.id}
                  value={pharmacy.id}
                >
                  {pharmacy.name}
                </option>
              ))}
            </select>
          )}

          {canManageInventory && (
            <>
              <button
                type="button"
                onClick={() =>
                  void handleDownloadTemplate()
                }
                disabled={
                  downloadingTemplate ||
                  importingExcel
                }
                className="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {downloadingTemplate ? (
                  <span className="h-4 w-4 animate-spin rounded-full border-2 border-slate-200 border-t-slate-700" />
                ) : (
                  <Download className="h-4 w-4" />
                )}
                نمونه Excel
              </button>

              <label
                className={`inline-flex cursor-pointer items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-xs font-bold text-emerald-800 transition hover:bg-emerald-100 ${
                  importingExcel
                    ? 'cursor-not-allowed opacity-50'
                    : ''
                }`}
              >
                {importingExcel ? (
                  <span className="h-4 w-4 animate-spin rounded-full border-2 border-emerald-200 border-t-emerald-700" />
                ) : (
                  <FileSpreadsheet className="h-4 w-4" />
                )}

                {importingExcel
                  ? 'در حال Import...'
                  : 'Import Excel'}

                <input
                  key={importInputKey}
                  type="file"
                  accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                  className="hidden"
                  disabled={importingExcel}
                  onChange={(event) =>
                    void handleExcelImport(event)
                  }
                />
              </label>

              <button
                type="button"
                onClick={openCreateModal}
                disabled={
                  products.length === 0 ||
                  importingExcel
                }
                className="inline-flex items-center gap-2 rounded-xl bg-medical-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-medical-700 disabled:cursor-not-allowed disabled:opacity-50"
              >

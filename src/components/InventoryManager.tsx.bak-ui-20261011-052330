                    className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm outline-none focus:border-medical-500"
                  />
                </div>
              </div>

              <div className="grid gap-4 sm:grid-cols-3">
                <div>
                  <label className="mb-2 block text-xs font-bold text-slate-700">
                    موجودی
                  </label>

                  <input
                    type="number"
                    min="0"
                    value={
                      form.currentStock
                    }
                    onChange={(event) =>
                      updateForm({
                        currentStock:
                          Number(
                            event.target
                              .value,
                          ),
                      })
                    }
                    required
                    className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm outline-none focus:border-medical-500"
                  />
                </div>

                <div>
                  <label className="mb-2 block text-xs font-bold text-slate-700">
                    فروش روزانه
                  </label>

                  <input
                    type="number"
                    min="0"
                    step="0.1"
                    value={
                      form.dailySalesVelocity
                    }
                    onChange={(event) =>
                      updateForm({
                        dailySalesVelocity:
                          Number(
                            event.target
                              .value,
                          ),
                      })
                    }
                    className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm outline-none focus:border-medical-500"
                  />
                </div>
              </div>

              <div className="grid gap-4 sm:grid-cols-3">
                <div>
                  <label className="mb-2 block text-xs font-bold text-slate-700">
                    قیمت خرید
                  </label>

                  <input
                    type="number"
                    min="0"
                    value={
                      form.originalCost
                    }
                    onChange={(event) =>
                      updateForm({
                        originalCost:
                          Number(
                            event.target
                              .value,
                          ),
                      })
                    }
                    required
                    className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm outline-none focus:border-medical-500"
                  />
                </div>

                <div>
                  <label className="mb-2 block text-xs font-bold text-slate-700">
                    قیمت فروش
                  </label>

                  <input
                    type="number"
                    min="0"
                    value={
                      form.sellingPrice
                    }
                    onChange={(event) =>
                      updateForm({
                        sellingPrice:
                          Number(
                            event.target
                              .value,
                          ),
                      })
                    }
                    required
                    className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm outline-none focus:border-medical-500"
                  />
                </div>

                <div>
                  <label className="mb-2 block text-xs font-bold text-slate-700">
                    حداقل قیمت B2B
                  </label>

                  <input
                    type="number"
                    min="0"
                    value={
                      form.minAcceptablePriceB2B
                    }
                    onChange={(event) =>
                      updateForm({
                        minAcceptablePriceB2B:
                          Number(
                            event.target
                              .value,
                          ),
                      })
                    }
                    required
                    className="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm outline-none focus:border-medical-500"
                  />
                </div>
              </div>

              <div className="flex items-start gap-2 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs leading-6 text-emerald-800">
                <Info className="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" />

                <span>
                  سطح ریسک، روزهای مانده تا انقضا و پوشش موجودی توسط Backend محاسبه می‌شود.
                </span>
              </div>

              <div className="flex justify-end gap-2 border-t border-slate-100 pt-4">
                <button
                  type="button"
                  onClick={closeModal}
                  disabled={saving}
                  className="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-600 transition hover:bg-slate-50 disabled:opacity-50"
                >
                  انصراف
                </button>

                <button
                  type="submit"
                  disabled={saving}
                  className="inline-flex items-center gap-2 rounded-xl bg-medical-600 px-5 py-2.5 text-xs font-bold text-white transition hover:bg-medical-700 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {saving ? (
                    <>
                      <span className="h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white" />
                      در حال ذخیره...
                    </>
                  ) : editingItem ? (
                    <>
                      <Check className="h-4 w-4" />
                      ذخیره تغییرات
                    </>
                  ) : (
                    <>
                      <Plus className="h-4 w-4" />
                      ثبت در موجودی
                    </>
                  )}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

                        riskTotal) *
                      100
                    ).toFixed(2)}% ${(
                      ((metrics.optimal.length +
                        metrics.warning.length +
                        metrics.lowStock.length) /
                        riskTotal) *
                      100
                    ).toFixed(2)}%,
                    #f43f5e ${(
                      ((metrics.optimal.length +
                        metrics.warning.length +
                        metrics.lowStock.length) /
                        riskTotal) *
                      100
                    ).toFixed(2)}% 100%
                  )`,
                }}
              />

              <div className="absolute inset-5 flex flex-col items-center justify-center rounded-full bg-white">
                <span className="text-2xl font-black text-slate-900">
                  {formatNumber(stockItems.length)}
                </span>
                <span className="text-[10px] font-bold text-slate-400">
                  قلم موجودی
                </span>
              </div>
            </div>

            <div className="space-y-3">
              <RiskRow
                label="وضعیت مناسب"
                count={metrics.optimal.length}
                total={riskTotal}
                percent={
                  (metrics.optimal.length /
                    riskTotal) *
                  100
                }
                className="bg-emerald-500"
              />

              <RiskRow
                label="هشدار"
                count={metrics.warning.length}
                total={riskTotal}
                percent={
                  (metrics.warning.length /
                    riskTotal) *
                  100
                }
                className="bg-amber-500"
              />

              <RiskRow
                label="کم‌موجودی"
                count={metrics.lowStock.length}
                total={riskTotal}
                percent={
                  (metrics.lowStock.length /
                    riskTotal) *
                  100
                }
                className="bg-orange-500"
              />

              <RiskRow
                label="بحرانی"
                count={metrics.critical.length}
                total={riskTotal}
                percent={
                  (metrics.critical.length /
                    riskTotal) *
                  100
                }
                className="bg-rose-500"
              />
            </div>
          </div>
        </Panel>

        <Panel
          title="وضعیت انقضا"
          subtitle="تقسیم‌بندی بر اساس روز باقی‌مانده"
          icon={CalendarClock}
        >
          <div className="space-y-5">
            <ExpiryBar
              label="کمتر از ۳۰ روز"
              count={metrics.expiry30.length}
              total={stockItems.length}
              className="bg-rose-500"
            />

            <ExpiryBar
              label="۳۰ تا ۶۰ روز"
              count={metrics.expiry60.length}
              total={stockItems.length}
              className="bg-amber-500"
            />

            <ExpiryBar
              label="۶۰ تا ۹۰ روز"
              count={metrics.expiry90.length}
              total={stockItems.length}
              className="bg-violet-500"
            />

            <div className="rounded-2xl border border-rose-100 bg-rose-50 p-4">
              <div className="flex items-center justify-between">
                <div>
                  <div className="text-xs font-black text-rose-700">
                    نیازمند اقدام
                  </div>
                  <div className="mt-1 text-[11px] text-rose-600/80">
                    اقلام با انقضای حداکثر ۹۰ روز
                  </div>
                </div>

                <div className="text-2xl font-black text-rose-700">
                  {formatNumber(
                    metrics.nearExpiry.length,
                  )}
                </div>
              </div>
            </div>
          </div>
        </Panel>
      </section>

      {/* Availability + velocity */}
      <section className="grid gap-5 xl:grid-cols-[0.8fr_1.2fr]">
        <Panel
          title="قابل فروش در برابر رزروشده"
          subtitle="وضعیت ظرفیت عملیاتی موجودی"
          icon={Warehouse}
        >
          <div className="flex items-center gap-5">
            <div className="relative h-28 w-28 shrink-0">
              <div
                className="h-full w-full rounded-full"
                style={{
                  background: `conic-gradient(#10b981 0 ${availablePercent}%, #94a3b8 ${availablePercent}% 100%)`,
                }}
              />
              <div className="absolute inset-4 flex items-center justify-center rounded-full bg-white">
                <span className="text-xl font-black text-slate-900">
                  {formatNumber(availablePercent)}%
                </span>
              </div>
            </div>

            <div className="min-w-0 flex-1 space-y-4">
              <LegendRow
                label="قابل فروش"
                value={metrics.availableUnits}
                percent={availablePercent}
                className="bg-emerald-500"
              />

              <LegendRow
                label="رزروشده"
                value={metrics.reservedUnits}
                percent={reservedPercent}
                className="bg-slate-400"
              />
            </div>
          </div>
        </Panel>

        <Panel
          title="محصولات با بیشترین سرعت فروش"
          subtitle="بر اساس daily sales velocity"
          icon={TrendingUp}
        >
          <div className="space-y-3">
            {metrics.topProducts.length === 0 ? (
              <EmptyState text="هنوز داده فروش برای نمایش وجود ندارد." />
            ) : (
              metrics.topProducts.map((item, index) => (
                <div
                  key={item.id}
                  className="grid grid-cols-[28px_1fr_auto] items-center gap-3"
                >
                  <div className="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-[11px] font-black text-slate-500">
                    {formatNumber(index + 1)}
                  </div>

                  <div className="min-w-0">
                    <div className="truncate text-xs font-black text-slate-800">
                      {item.product.name}
                    </div>

                    <div className="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
                      <div
                        className="h-full rounded-full bg-emerald-500"
                        style={{
                          width: `${Math.max(
                            (item.dailySalesVelocity /
                              maxVelocity) *
                              100,
                            item.dailySalesVelocity
                              ? 5
                              : 0,
                          )}%`,
                        }}
                      />
                    </div>
                  </div>

                  <div className="text-left">
                    <div className="text-sm font-black text-slate-900">
                      {formatNumber(
                        item.dailySalesVelocity,
                      )}
                    </div>
                    <div className="text-[9px] text-slate-400">
                      واحد/روز
                    </div>
                  </div>
                </div>
              ))
            )}
          </div>
        </Panel>
      </section>

      {/* Expiry + quick actions */}
      <section className="grid gap-5 xl:grid-cols-[1.25fr_0.75fr]">
        <Panel
          title="نزدیک‌ترین اقلام به انقضا"
          subtitle="مواردی که باید زودتر برای مصرف یا تبادل تصمیم‌گیری شوند"
          icon={Clock3}
          action={
            <button
              type="button"
              onClick={() =>
                onNavigate('inventory_mgmt')
              }
              className="flex items-center gap-1 text-xs font-black text-medical-600 hover:text-medical-700"
            >
              مشاهده موجودی
              <ArrowLeft className="h-4 w-4" />
            </button>
          }
        >
          {metrics.expiringSoon.length === 0 ? (
            <EmptyState text="موردی با انقضای نزدیک وجود ندارد." />
          ) : (
            <div className="space-y-2">
              {metrics.expiringSoon.map((item) => (
                <div
                  key={item.id}
                  className="flex items-center gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3 transition hover:border-medical-100 hover:bg-medical-50/40"
                >
                  <div
                    className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${
                      item.daysToExpiry <= 30
                        ? 'bg-rose-100 text-rose-600'
                        : item.daysToExpiry <= 60
                          ? 'bg-amber-100 text-amber-600'
                          : 'bg-violet-100 text-violet-600'
                    }`}
                  >
                    <CalendarClock className="h-5 w-5" />
                  </div>

                  <div className="min-w-0 flex-1">
                    <div className="truncate text-xs font-black text-slate-900">
                      {item.product.name}
                    </div>

                    <div className="mt-1 text-[10px] text-slate-500">
                      بچ {item.batchNumber} ·{' '}
                      {formatNumber(item.currentStock)} واحد
                    </div>
                  </div>

                  <div className="text-left">
                    <div
                      className={`text-sm font-black ${
                        item.daysToExpiry <= 30
                          ? 'text-rose-600'
                          : item.daysToExpiry <= 60
                            ? 'text-amber-600'
                            : 'text-violet-600'
                      }`}
                    >
                      {formatNumber(
                        Math.max(
                          item.daysToExpiry,
                          0,
                        ),
                      )}
                    </div>

                    <div className="text-[9px] text-slate-400">
                      روز
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </Panel>

        <Panel
          title="عملیات سریع"
          subtitle="دسترسی مستقیم به بخش‌های اصلی"
          icon={Activity}
        >
          <div className="space-y-2">
            <QuickAction
              icon={PackageCheck}
              title="مدیریت موجودی"
              description="ثبت بچ، Excel و کنترل FEFO"
              onClick={() =>
                onNavigate('inventory_mgmt')
              }
            />

            <QuickAction
              icon={ShoppingCart}
              title="تبادل B2B"
              description="پیشنهادها و سفارش‌های بین داروخانه‌ای"
              onClick={() =>
                onNavigate('ai_exchange')
              }
            />

            <QuickAction
              icon={Store}
              title="ویترین داروخانه"
              description="نمای فروشگاه و محصولات"
              onClick={() =>
                onNavigate('storefront_demo')
              }
            />
          </div>
        </Panel>
      </section>

      {/* Action center */}
      <Panel
        title="مرکز اقدام"
        subtitle="اقلامی که اکنون نیاز به بررسی دارند"
        icon={AlertTriangle}
        action={
          <div className="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black text-slate-500">
            {formatNumber(
              metrics.actionItems.length,
            )}{' '}
            مورد
          </div>
        }
      >
        {metrics.actionItems.length === 0 ? (
          <div className="flex flex-col items-center justify-center rounded-2xl border border-emerald-100 bg-emerald-50 p-8 text-center">
            <CheckCircle2 className="h-10 w-10 text-emerald-500" />
            <div className="mt-3 text-sm font-black text-emerald-800">
              وضعیت موجودی مناسب است
            </div>
            <div className="mt-1 text-xs text-emerald-600">
              در حال حاضر مورد فوری برای اقدام وجود ندارد.
            </div>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full min-w-[720px] text-right">
              <thead>
                <tr className="border-b border-slate-100 text-[10px] font-black text-slate-400">
                  <th className="px-3 py-3">محصول</th>
                  <th className="px-3 py-3">بچ</th>
                  <th className="px-3 py-3">موجودی</th>
                  <th className="px-3 py-3">انقضا</th>
                  <th className="px-3 py-3">وضعیت</th>
                  <th className="px-3 py-3">اقدام</th>
                </tr>
              </thead>

              <tbody className="divide-y divide-slate-100">
                {metrics.actionItems.map((item) => (
                  <tr
                    key={item.id}
                    className="text-xs transition hover:bg-slate-50"
                  >
                    <td className="px-3 py-3 font-black text-slate-800">

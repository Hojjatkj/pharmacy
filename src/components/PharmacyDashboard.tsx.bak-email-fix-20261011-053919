      </Panel>

      {/* Footer status */}
      <div className="flex flex-col gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-[10px] text-slate-400 shadow-sm sm:flex-row sm:items-center sm:justify-between">
        <div className="flex items-center gap-2">
          <span className="h-2 w-2 rounded-full bg-emerald-500" />
          داشبورد متصل به داده‌های واقعی موجودی
        </div>

        <div className="flex items-center gap-3">
          <span>
            {formatNumber(stockItems.length)} قلم
          </span>
          <span>·</span>
          <span>
            {formatNumber(metrics.totalUnits)} واحد
          </span>
          <span>·</span>
          <span>
            {formatNumber(metrics.nearExpiry.length)} نزدیک انقضا
          </span>
        </div>
      </div>
    </div>
  );
}

function Panel({
  title,
  subtitle,
  icon: Icon,
  action,
  children,
}: {
  title: string;
  subtitle: string;
  icon: React.ElementType;
  action?: React.ReactNode;
  children: React.ReactNode;
}) {
  return (
    <section className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div className="mb-5 flex items-start justify-between gap-4">
        <div className="flex items-start gap-3">
          <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <Icon className="h-5 w-5" />
          </div>

          <div>
            <h2 className="text-sm font-black text-slate-900">
              {title}
            </h2>

            <p className="mt-1 text-[10px] leading-5 text-slate-400">
              {subtitle}
            </p>
          </div>
        </div>

        {action}
      </div>

      {children}
    </section>
  );
}

function MetricCard({
  icon: Icon,
  title,
  value,
  description,
  accent,
}: {
  icon: React.ElementType;
  title: string;
  value: string;
  description: string;
  accent: 'emerald' | 'blue' | 'violet' | 'amber';
}) {
  const classes = {
    emerald: 'bg-emerald-50 text-emerald-600',
    blue: 'bg-blue-50 text-blue-600',
    violet: 'bg-violet-50 text-violet-600',
    amber: 'bg-amber-50 text-amber-600',
  };

  return (
    <div className="rounded-[22px] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
      <div className="flex items-start justify-between gap-3">
        <div>
          <div className="text-[10px] font-bold text-slate-400">
            {title}
          </div>

          <div className="mt-2 text-xl font-black tracking-tight text-slate-900">
            {value}
          </div>

          <div className="mt-1 text-[10px] font-medium text-slate-400">
            {description}
          </div>
        </div>

        <div
          className={`flex h-10 w-10 items-center justify-center rounded-xl ${classes[accent]}`}
        >
          <Icon className="h-5 w-5" />
        </div>
      </div>
    </div>
  );
}

function RiskRow({
  label,
  count,
  total,
  percent,
  className,
}: {
  label: string;
  count: number;
  total: number;
  percent: number;
  className: string;
}) {
  return (
    <div>
      <div className="mb-1.5 flex items-center justify-between text-[10px]">
        <span className="font-bold text-slate-600">
          {label}
        </span>
        <span className="font-black text-slate-800">
          {formatNumber(count)}{' '}
          <span className="font-medium text-slate-400">
            ({formatNumber(percent)}%)
          </span>
        </span>
      </div>

      <div className="h-2 overflow-hidden rounded-full bg-slate-100">
        <div
          className={`h-full rounded-full ${className}`}
          style={{
            width: `${Math.min(
              Math.max(percent, count ? 3 : 0),
              100,
            )}%`,
          }}
        />
      </div>
    </div>
  );
}

function ExpiryBar({
  label,
  count,
  total,
  className,
}: {
  label: string;
  count: number;
  total: number;
  className: string;
}) {
  const percent =
    total > 0 ? (count / total) * 100 : 0;

  return (
    <div>
      <div className="mb-2 flex items-center justify-between text-xs">
        <span className="font-bold text-slate-600">
          {label}
        </span>
        <span className="font-black text-slate-800">
          {formatNumber(count)}
        </span>
      </div>

      <div className="h-3 overflow-hidden rounded-full bg-slate-100">
        <div
          className={`h-full rounded-full ${className}`}
          style={{
            width: `${Math.min(
              Math.max(percent, count ? 4 : 0),
              100,
            )}%`,
          }}
        />
      </div>
    </div>
  );
}

function LegendRow({
  label,
  value,
  percent,
  className,
}: {
  label: string;
  value: number;
  percent: number;
  className: string;
}) {
  return (
    <div>
      <div className="flex items-center justify-between text-xs">
        <div className="flex items-center gap-2">
          <span
            className={`h-2.5 w-2.5 rounded-full ${className}`}
          />
          <span className="font-bold text-slate-600">
            {label}
          </span>
        </div>

        <span className="font-black text-slate-900">
          {formatNumber(value)}
        </span>
      </div>

      <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-100">
        <div
          className={`h-full rounded-full ${className}`}
          style={{
            width: `${Math.min(percent, 100)}%`,
          }}
        />
      </div>
    </div>
  );
}

function QuickAction({
  icon: Icon,
  title,
  description,
  onClick,
}: {
  icon: React.ElementType;
  title: string;
  description: string;
  onClick: () => void;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className="group flex w-full items-center gap-3 rounded-2xl border border-slate-100 bg-slate-50 p-3 text-right transition hover:border-medical-200 hover:bg-medical-50"
    >
      <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-medical-600 shadow-sm transition group-hover:bg-medical-600 group-hover:text-white">
        <Icon className="h-5 w-5" />
      </div>

      <div className="min-w-0 flex-1">
        <div className="text-xs font-black text-slate-800">
          {title}
        </div>

        <div className="mt-1 truncate text-[10px] text-slate-400">
          {description}
        </div>
      </div>

      <ArrowLeft className="h-4 w-4 text-slate-300 transition group-hover:text-medical-600" />
    </button>
  );
}

function EmptyState({ text }: { text: string }) {
  return (
    <div className="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-7 text-center">
      <CheckCircle2 className="mx-auto h-8 w-8 text-emerald-400" />
      <p className="mt-2 text-xs font-bold text-slate-500">
        {text}
      </p>
    </div>
  );
}

import React, { useMemo, useState } from 'react';
import {
  Activity,\n  Mail,\n  Send,
  AlertTriangle,
  ArrowLeft,
  BarChart3,
  Boxes,
  CalendarClock,
  CheckCircle2,
  CircleDollarSign,
  Clock3,
  PackageCheck,
  RefreshCw,
  ShoppingCart,
  Store,
  TrendingDown,
  TrendingUp,
  Warehouse,
  Zap,
} from 'lucide-react';

import {
  ActiveTab,
  Pharmacy,
  PharmacyStockItem,
} from '../types';

interface PharmacyDashboardProps {
  pharmacy: Pharmacy;
  stockItems: PharmacyStockItem[];
  onNavigate: (tab: ActiveTab) => void;
  onRefresh: () => void;
}

const numberFormatter = new Intl.NumberFormat('fa-IR');

function formatNumber(value: number) {
  return numberFormatter.format(Math.round(value));
}

function formatMoney(value: number) {
  return `${numberFormatter.format(Math.round(value))} ریال`;
}

function shortMoney(value: number) {
  const million = value / 1_000_000;

  if (million >= 1) {
    return `${numberFormatter.format(
      Math.round(million * 10) / 10,
    )}M`;
  }

  return formatNumber(value);
}

function riskLabel(risk: PharmacyStockItem['riskLevel']) {
  switch (risk) {
    case 'critical':
      return 'بحرانی';
    case 'warning':
      return 'هشدار';
    case 'low_stock':
      return 'کم‌موجودی';
    default:
      return 'مناسب';
  }
}

function riskClass(risk: PharmacyStockItem['riskLevel']) {
  switch (risk) {
    case 'critical':
      return 'bg-rose-100 text-rose-700 border-rose-200';
    case 'warning':
      return 'bg-amber-100 text-amber-700 border-amber-200';
    case 'low_stock':
      return 'bg-orange-100 text-orange-700 border-orange-200';
    default:
      return 'bg-emerald-100 text-emerald-700 border-emerald-200';
  }
}

export function PharmacyDashboard({
  pharmacy,
  stockItems,
  onNavigate,
  onRefresh,
}: PharmacyDashboardProps) {
  const metrics = useMemo(() => {
    const totalUnits = stockItems.reduce(
      (sum, item) => sum + item.currentStock,
      0,
    );

    const reservedUnits = stockItems.reduce(
      (sum, item) => sum + item.reservedStock,
      0,
    );

    const availableUnits = Math.max(
      totalUnits - reservedUnits,
      0,
    );

    const inventoryValue = stockItems.reduce(
      (sum, item) =>
        sum + item.currentStock * item.sellingPrice,
      0,
    );

    const dailyVelocity = stockItems.reduce(
      (sum, item) => sum + item.dailySalesVelocity,
      0,
    );

    const critical = stockItems.filter(
      (item) => item.riskLevel === 'critical',
    );

    const warning = stockItems.filter(
      (item) => item.riskLevel === 'warning',
    );

    const lowStock = stockItems.filter(
      (item) => item.riskLevel === 'low_stock',
    );

    const optimal = stockItems.filter(
      (item) => item.riskLevel === 'optimal',
    );

    const nearExpiry = stockItems.filter(
      (item) => item.daysToExpiry <= 90,
    );

    const expiry30 = stockItems.filter(
      (item) => item.daysToExpiry <= 30,
    );

    const expiry60 = stockItems.filter(
      (item) =>
        item.daysToExpiry > 30 &&
        item.daysToExpiry <= 60,
    );

    const expiry90 = stockItems.filter(
      (item) =>
        item.daysToExpiry > 60 &&
        item.daysToExpiry <= 90,
    );

    const expiringSoon = [...nearExpiry]
      .sort(
        (a, b) =>
          a.daysToExpiry - b.daysToExpiry,
      )
      .slice(0, 6);

    const topProducts = [...stockItems]
      .sort(
        (a, b) =>
          b.dailySalesVelocity -
          a.dailySalesVelocity,
      )
      .slice(0, 6);

    const actionItems = [...stockItems]
      .filter(
        (item) =>
          item.riskLevel !== 'optimal' ||
          item.daysToExpiry <= 90,
      )
      .sort((a, b) => {
        const aScore =
          (a.riskLevel === 'critical' ? 1000 : 0) +
          (a.riskLevel === 'warning' ? 500 : 0) +
          (a.daysToExpiry <= 30 ? 300 : 0) +
          (a.daysToExpiry <= 90 ? 100 : 0);

        const bScore =
          (b.riskLevel === 'critical' ? 1000 : 0) +
          (b.riskLevel === 'warning' ? 500 : 0) +
          (b.daysToExpiry <= 30 ? 300 : 0) +
          (b.daysToExpiry <= 90 ? 100 : 0);

        return bScore - aScore;
      })
      .slice(0, 7);

    return {
      totalUnits,
      reservedUnits,
      availableUnits,
      inventoryValue,
      dailyVelocity,
      critical,
      warning,
      lowStock,
      optimal,
      nearExpiry,
      expiry30,
      expiry60,
      expiry90,
      expiringSoon,
      topProducts,
      actionItems,
    };
  }, [stockItems]);

  const riskTotal = Math.max(stockItems.length, 1);
  const maxVelocity = Math.max(
    ...metrics.topProducts.map(
      (item) => item.dailySalesVelocity,
    ),
    1,
  );

  const availablePercent =
    metrics.totalUnits > 0
      ? Math.round(
          (metrics.availableUnits /
            metrics.totalUnits) *
            100,
        )
      : 0;

  const reservedPercent =
    metrics.totalUnits > 0
      ? Math.round(
          (metrics.reservedUnits /
            metrics.totalUnits) *
            100,
        )
      : 0;

  return (
    <div dir="rtl" className="space-y-5 pb-8">
      {/* Hero */}
      <section className="overflow-hidden rounded-[28px] border border-emerald-900/20 bg-emerald-950 shadow-lg shadow-emerald-900/10">
        <div className="relative overflow-hidden bg-gradient-to-l from-emerald-950 via-emerald-900 to-emerald-800 p-6 text-white sm:p-8">
          <div className="pointer-events-none absolute -left-16 -top-24 h-64 w-64 rounded-full bg-emerald-400/10 blur-3xl" />
          <div className="pointer-events-none absolute -bottom-24 right-1/3 h-56 w-56 rounded-full bg-teal-300/10 blur-3xl" />

          <div className="relative flex flex-col gap-6 xl:flex-row xl:items-center xl:justify-between">
            <div>
              <div className="mb-3 flex items-center gap-2 text-xs font-bold text-emerald-200">
                <Store className="h-4 w-4" />
                مرکز کنترل داروخانه
                <span className="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5">
                  LIVE
                </span>
              </div>

              <h1 className="text-2xl font-black tracking-tight sm:text-3xl">
                {pharmacy.avatar} {pharmacy.name}
              </h1>

              <p className="mt-2 text-sm text-emerald-100/80">
                {pharmacy.city} · {pharmacy.province}
                {pharmacy.licenseNumber
                  ? ` · پروانه ${pharmacy.licenseNumber}`
                  : ''}
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-2">
              <div className="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 backdrop-blur">
                <div className="text-[10px] font-medium text-emerald-200">
                  امتیاز اعتماد
                </div>
                <div className="mt-1 text-lg font-black">
                  {formatNumber(pharmacy.trustScore)}
                  <span className="mr-1 text-xs font-medium text-emerald-200">
                    /100
                  </span>
                </div>
              </div>

              <div className="rounded-2xl border border-white/10 bg-white/10 px-4 py-3 backdrop-blur">
                <div className="text-[10px] font-medium text-emerald-200">
                  B2B
                </div>
                <div className="mt-1 flex items-center gap-1.5 text-sm font-black">
                  <span
                    className={`h-2 w-2 rounded-full ${
                      pharmacy.activeB2BExchange
                        ? 'bg-emerald-300 shadow-[0_0_10px_rgba(110,231,183,0.8)]'
                        : 'bg-slate-400'
                    }`}
                  />
                  {pharmacy.activeB2BExchange
                    ? 'فعال'
                    : 'غیرفعال'}
                </div>
              </div>

              <button
                type="button"
                onClick={onRefresh}
                className="flex items-center gap-2 rounded-2xl bg-white px-4 py-3 text-sm font-black text-medical-900 shadow-sm transition hover:bg-medical-50"
              >
                <RefreshCw className="h-4 w-4" />
                بروزرسانی
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* KPI */}
      <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <MetricCard
          icon={Boxes}
          title="قلم موجودی"
          value={formatNumber(stockItems.length)}
          description="بچ‌های ثبت‌شده"
          accent="emerald"
        />

        <MetricCard
          icon={Warehouse}
          title="واحد موجود"
          value={formatNumber(metrics.totalUnits)}
          description={`${formatNumber(metrics.availableUnits)} قابل فروش`}
          accent="blue"
        />

        <MetricCard
          icon={CircleDollarSign}
          title="ارزش موجودی"
          value={formatMoney(metrics.inventoryValue)}
          description="بر اساس قیمت فروش"
          accent="violet"
        />

        <MetricCard
          icon={Zap}
          title="سرعت فروش"
          value={formatNumber(metrics.dailyVelocity)}
          description="واحد در روز"
          accent="amber"
        />
      </section>

      {/* Operational overview */}
      <section className="grid gap-5 xl:grid-cols-[1.15fr_0.85fr]">
        <Panel
          title="نمای کلی موجودی"
          subtitle="توزیع اقلام بر اساس سطح ریسک"
          icon={BarChart3}
        >
          <div className="grid gap-6 md:grid-cols-[180px_1fr] md:items-center">
            <div className="relative mx-auto h-40 w-40">
              <div
                className="h-full w-full rounded-full"
                style={{
                  background: `conic-gradient(
                    #10b981 0 ${(
                      (metrics.optimal.length /
                        riskTotal) *
                      100
                    ).toFixed(2)}%,
                    #f59e0b ${(
                      (metrics.optimal.length /

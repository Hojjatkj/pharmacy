                    </td>

                    <td className="px-3 py-3 text-slate-500">
                      {item.batchNumber}
                    </td>

                    <td className="px-3 py-3 font-bold text-slate-700">
                      {formatNumber(
                        item.currentStock,
                      )}
                    </td>

                    <td className="px-3 py-3">
                      <span
                        className={
                          item.daysToExpiry <= 30
                            ? 'font-black text-rose-600'

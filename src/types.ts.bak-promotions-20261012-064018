export interface ProductItem {
  id: string;
  name: string;
  genericName: string;
  category: 'supplement' | 'cosmetic' | 'otc_health' | 'sports_nutrition';
  brand: string;
  ircCode: string;
  gtin: string;
  unit: string;
  basePrice: number; // Rial / Toman
}

export interface PharmacyStockItem {
  id: string;
  pharmacyId: string;
  productId: string;
  product: ProductItem;
  batchNumber: string;
  expiryDate: string; // YYYY-MM-DD
  daysToExpiry: number;
  currentStock: number;
  reservedStock: number;
  dailySalesVelocity: number; // burn rate per day
  daysOfInventoryLeft: number; // currentStock / dailySalesVelocity
  riskLevel: 'critical' | 'warning' | 'optimal' | 'low_stock';
  originalCost: number;
  sellingPrice: number;
  minAcceptablePriceB2B: number;
}

export interface Pharmacy {
  id: string;
  name: string;
  licenseNumber: string;
  technicalManager: string;
  city: string;
  province: string;
  address: string;
  phone: string;
  trustScore: number; // 0-100
  activeB2BExchange: boolean;
  avatar: string;
}

export interface B2BExchangeMatch {
  id: string;
  sourcePharmacy: Pharmacy;
  targetPharmacy: Pharmacy;
  product: ProductItem;
  batchNumber: string;
  expiryDate: string;
  availableQuantity: number;
  recommendedTransferQty: number;
  originalPrice: number;
  aiSuggestedPrice: number;
  discountPercentage: number;
  estimatedLossAvoided: number; // Value in Toman
  targetDemandVelocity: number;
  reasoning: string;
  matchScore: number; // 0-100
  status: 'pending' | 'negotiating' | 'escrow_funded' | 'shipped' | 'delivered' | 'completed' | 'rejected';
}

export interface EscrowTransaction {
  id: string;
  exchangeId: string;
  buyerPharmacyId: string;
  sellerPharmacyId: string;
  totalAmount: number;
  platformFee: number;
  sellerNetPayout: number;
  status: 'created' | 'funded_escrow' | 'goods_dispatched' | 'inspection_approved' | 'settled' | 'refunded';
  trackingCode: string;
  createdAt: string;
  settlementDate?: string;
  shabaNumber: string;
  inspectionOtp: string;
}

export type ActiveTab = 'dashboard' | 'operational_plan' | 'ai_exchange' | 'inventory_mgmt' | 'escrow_payment' | 'storefront_demo' | 'admin_users';

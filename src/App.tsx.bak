import React, {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from 'react';

import {
  getMe,
  logout,
  MeResponse,
} from './api/auth';

import {
  getInventory,
} from './api/inventory';

import {
  getPharmacies,
} from './api/pharmacies';

import {
  getProducts,
} from './api/products';

import {
  ActiveTab,
  B2BExchangeMatch,
  Pharmacy,
  PharmacyStockItem,
  ProductItem,
} from './types';

import { Navbar } from './components/Navbar';
import { LoginPage } from './components/LoginPage';
import { ProfilePage } from './components/ProfilePage';
import { InventoryManager } from './components/InventoryManager';
import { AiExchangeEngine } from './components/AiExchangeEngine';
import { EscrowPaymentSimulator } from './components/EscrowPaymentSimulator';
import { OperationalPlanView } from './components/OperationalPlanView';
import { StorefrontPreview } from './components/StorefrontPreview';
import { RoadmapTimeline } from './components/RoadmapTimeline';

import { initialAiMatches } from './data/mockData';

const App: React.FC = () => {
  const [activeTab, setActiveTab] =
    useState<ActiveTab>('operational_plan');

  const [currentUser, setCurrentUser] =
    useState<MeResponse | null>(null);

  const [authenticated, setAuthenticated] =
    useState(
      Boolean(localStorage.getItem('accessToken')),
    );

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState<string | null>(null);

  const [pharmacies, setPharmacies] =
    useState<Pharmacy[]>([]);

  const [products, setProducts] =
    useState<ProductItem[]>([]);

  const [stockItems, setStockItems] =
    useState<PharmacyStockItem[]>([]);

  const [selectedPharmacy, setSelectedPharmacy] =
    useState<Pharmacy | null>(null);

  const [aiMatches, setAiMatches] =
    useState<B2BExchangeMatch[]>(
      initialAiMatches,
    );

  const [selectedMatchForEscrow, setSelectedMatchForEscrow] =
    useState<B2BExchangeMatch | null>(null);

  const [showProfile, setShowProfile] =
    useState(false);

  /*
   * دریافت اطلاعات اصلی کاربر و داشبورد
   */
  const loadBackendData = useCallback(
    async (
      user?: MeResponse,
      pharmacyIdOverride?: string,
    ) => {
      setLoading(true);
      setError(null);

      try {
        const me = user ?? (await getMe());

        setCurrentUser(me);

        const pharmacyData =
          await getPharmacies();

        const effectivePharmacyId =
          pharmacyIdOverride ??
          (me.role === 'PLATFORM_ADMIN'
            ? selectedPharmacy?.id
            : me.pharmacyId ?? undefined);

        const [
          inventoryData,
          productData,
        ] = await Promise.all([
          getInventory(
            effectivePharmacyId,
          ),
          getProducts(),
        ]);

        setPharmacies(pharmacyData);
        setStockItems(inventoryData);
        setProducts(productData);

        /*
         * برای Owner/Staff فقط داروخانه خودشان
         * باید active باشد.
         *
         * برای Admin می‌توان اولین داروخانه را
         * به عنوان داروخانه فعال انتخاب کرد.
         */
        const ownPharmacy =
          me.pharmacyId
            ? pharmacyData.find(
                (pharmacy) =>
                  pharmacy.id === me.pharmacyId,
              ) ?? null
            : null;

        if (ownPharmacy) {
          setSelectedPharmacy(ownPharmacy);
        } else if (
          me.role === 'PLATFORM_ADMIN'
        ) {
          setSelectedPharmacy(
            (current) =>
              current &&
              pharmacyData.some(
                (pharmacy) =>
                  pharmacy.id === current.id,
              )
                ? current
                : pharmacyData[0] ?? null,
          );
        } else {
          setSelectedPharmacy(null);
        }
      } catch (err) {
        console.error(err);

        if (
          err instanceof Error &&
          /401|unauthorized|unauthenticated/i.test(
            err.message,
          )
        ) {
          logout();

          setAuthenticated(false);
          setCurrentUser(null);
          setSelectedPharmacy(null);

          return;
        }

        setError(
          err instanceof Error
            ? err.message
            : 'دریافت اطلاعات سامانه انجام نشد.',
        );
      } finally {
        setLoading(false);
      }
    },
    [selectedPharmacy],
  );

  /*
   * LoginPage خودش login را انجام می‌دهد.
   * این callback فقط بعد از موفقیت، اطلاعات داشبورد را می‌گیرد.
   */
  const handleLoginSuccess = useCallback(
    async () => {
      setAuthenticated(true);
      await loadBackendData();
    },
    [loadBackendData],
  );

  /*
   * اگر قبلاً token داشته باشیم،
   * هنگام mount اطلاعات کاربر را بررسی می‌کنیم.
   */
  useEffect(() => {
    if (!authenticated) {
      setLoading(false);
      return;
    }

    void loadBackendData();
  }, [
    authenticated,
    loadBackendData,
  ]);

  /*
   * Logout
   */
  const handleLogout = useCallback(() => {
    logout();

    setAuthenticated(false);
    setCurrentUser(null);
    setPharmacies([]);
    setProducts([]);
    setStockItems([]);
    setSelectedPharmacy(null);
    setSelectedMatchForEscrow(null);
    setShowProfile(false);
    setActiveTab('operational_plan');
    setError(null);
  }, []);

  /*
   * انتخاب داروخانه
   *
   * فقط PLATFORM_ADMIN اجازه تغییر tenant دارد.
   * Owner/Staff به داروخانه خودشان محدود هستند.
   */
  const handleSelectPharmacy = useCallback(
    (pharmacy: Pharmacy) => {
      if (
        currentUser?.role !==
        'PLATFORM_ADMIN'
      ) {
        return;
      }

      setSelectedPharmacy(pharmacy);

      void loadBackendData(
        currentUser,
        pharmacy.id,
      );
    },
    [
      currentUser,
      loadBackendData,
    ],
  );

  /*
   * موجودی مرتبط با داروخانه فعال
   *
   * برای Admin موجودی را بر اساس pharmacyId
   * فیلتر می‌کنیم.
   *
   * برای Owner/Staff نیز backend از قبل tenant
   * را enforce می‌کند، ولی این فیلتر یک لایه UI
   * اضافه است.
   */
  const visibleStockItems =
    useMemo(() => {
      if (!selectedPharmacy) {
        return [];
      }

      return stockItems.filter(
        (item) =>
          item.pharmacyId ===
          selectedPharmacy.id,
      );
    }, [
      stockItems,
      selectedPharmacy,
    ]);

  /*
   * افزودن موجودی
   *
   * InventoryManager در نسخه جدید خودش
   * createInventoryItem را به backend می‌زند.
   *
   * این callback فقط state محلی را به‌روزرسانی
   * می‌کند.
   */
  const handleAddStockItem = useCallback(
    (item: PharmacyStockItem) => {
      setStockItems((current) => {
        const exists = current.some(
          (existing) =>
            existing.id === item.id,
        );

        if (exists) {
          return current.map((existing) =>
            existing.id === item.id
              ? item
              : existing,
          );
        }

        return [
          ...current,
          item,
        ];
      });
    },
    [],
  );

  const handleUpdateStockItem =
    useCallback(
      (item: PharmacyStockItem) => {
        setStockItems((current) =>
          current.map((existing) =>
            existing.id === item.id
              ? item
              : existing,
          ),
        );
      },
      [],
    );

  const handleDeleteStockItem =
    useCallback(
      (id: string) => {
        setStockItems((current) =>
          current.filter(
            (item) => item.id !== id,
          ),
        );
      },
      [],
    );

  /*
   * Push موجودی به Exchange
   *
   * فعلاً Exchange backend نداریم؛ بنابراین
   * این بخش mock است.
   *
   * بعداً با API واقعی B2B Exchange جایگزین می‌شود.
   */
  const handlePushToExchange = useCallback(
    (item: PharmacyStockItem) => {
      if (!selectedPharmacy) {
        return;
      }

      const existingMatch =
        aiMatches.find(
          (match) =>
            match.product.id ===
              item.product.id &&
            match.sourcePharmacy.id ===
              selectedPharmacy.id &&
            match.batchNumber ===
              item.batchNumber,
        );

      if (existingMatch) {
        setActiveTab('ai_exchange');

        return;
      }

      const targetPharmacy =
        pharmacies.find(
          (pharmacy) =>
            pharmacy.id !==
            selectedPharmacy.id,
        );

      if (!targetPharmacy) {
        setActiveTab('ai_exchange');

        return;
      }

      const availableQuantity = Math.max(
        0,
        item.currentStock -
          item.reservedStock,
      );

      const recommendedTransferQty =
        Math.max(
          1,
          Math.min(
            availableQuantity,
            Math.floor(
              item.dailySalesVelocity > 0
                ? item.currentStock -
                    item.reservedStock
                : availableQuantity,
            ),
          ),
        );

      const discountPercentage =
        item.originalCost > 0
          ? Math.max(
              0,
              Math.round(
                ((item.originalCost -
                  item.minAcceptablePriceB2B) /
                  item.originalCost) *
                  100,
              ),
            )
          : 0;

      const estimatedLossAvoided =
        Math.max(
          0,
          item.originalCost *
            availableQuantity -
            item.minAcceptablePriceB2B *
              availableQuantity,
        );

      const newMatch: B2BExchangeMatch = {
        id: `local-${Date.now()}`,
        sourcePharmacy:
          selectedPharmacy,
        targetPharmacy,
        product: item.product,
        batchNumber: item.batchNumber,
        expiryDate: item.expiryDate,
        availableQuantity,
        recommendedTransferQty,
        originalPrice: item.originalCost,
        aiSuggestedPrice:
          item.minAcceptablePriceB2B,
        discountPercentage,
        estimatedLossAvoided,
        targetDemandVelocity:
          0,
        reasoning:
          'این پیشنهاد فعلاً در رابط کاربری ایجاد شده و پس از پیاده‌سازی API تبادل B2B از موتور واقعی تطبیق استفاده خواهد کرد.',
        matchScore: 0,
        status: 'pending',
      };

      setAiMatches((current) => [
        newMatch,
        ...current,
      ]);

      setActiveTab('ai_exchange');
    },
    [
      aiMatches,
      pharmacies,
      selectedPharmacy,
    ],
  );

  /*
   * انتخاب Match برای Escrow
   */
  const handleOpenEscrow = useCallback(
    (match: B2BExchangeMatch) => {
      setSelectedMatchForEscrow(match);
      setActiveTab('escrow_payment');
    },
    [],
  );

  /*
   * اگر کاربر Login نیست
   */
  if (!authenticated) {
    return (
      <LoginPage
        onLoginSuccess={
          handleLoginSuccess
        }
      />
    );
  }

  /*
   * در حال دریافت اطلاعات
   */
  if (loading) {
    return (
      <div
        dir="rtl"
        className="flex min-h-screen items-center justify-center bg-slate-50"
      >
        <div className="text-center">
          <div className="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-slate-200 border-t-emerald-600" />

          <p className="mt-4 text-sm font-bold text-slate-600">
            در حال دریافت اطلاعات...
          </p>
        </div>
      </div>
    );
  }

  /*
   * اگر token وجود داشته ولی /me کاربر را
   * برنگرداند، به login برمی‌گردیم.
   */
  if (!currentUser) {
    return (
      <LoginPage
        onLoginSuccess={
          handleLoginSuccess
        }
      />
    );
  }

  /*
   * Admin می‌تواند بدون pharmacy هم وارد شود.
   *
   * Owner/Staff حتماً باید pharmacy داشته باشند.
   */
  const requiresPharmacy =
    currentUser.role !==
    'PLATFORM_ADMIN';

  if (
    requiresPharmacy &&
    !selectedPharmacy
  ) {
    return (
      <div
        dir="rtl"
        className="flex min-h-screen items-center justify-center bg-slate-50 p-6"
      >
        <div className="w-full max-w-md rounded-2xl border border-amber-200 bg-white p-8 text-center shadow-sm">
          <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-amber-600">
            !
          </div>

          <h1 className="mt-4 text-lg font-black text-slate-900">
            داروخانه‌ای برای حساب کاربری پیدا نشد
          </h1>

          <p className="mt-3 text-sm leading-7 text-slate-500">
            حساب کاربری شما به یک داروخانه متصل نیست.
            لطفاً اتصال حساب به داروخانه را بررسی کنید.
          </p>

          <button
            type="button"
            onClick={handleLogout}
            className="mt-6 h-11 rounded-xl bg-slate-900 px-6 text-sm font-extrabold text-white transition hover:bg-slate-800"
          >
            خروج از حساب
          </button>
        </div>
      </div>
    );
  }

  /*
   * اگر Profile باز باشد
   */
  if (showProfile) {
    return (
      <div
        dir="rtl"
        className="min-h-screen bg-slate-50"
      >
        <Navbar
          selectedPharmacy={
            selectedPharmacy ??
            pharmacies[0] ??
            ({
              id: '',
              name: 'مدیریت پلتفرم',
              licenseNumber: '',
              technicalManager: '',
              city: '',
              province: '',
              address: '',
              phone: '',
              trustScore: 0,
              activeB2BExchange: false,
              avatar: '',
            } as Pharmacy)
          }
          allPharmacies={pharmacies}
          onSelectPharmacy={
            handleSelectPharmacy
          }
          currentUser={currentUser}
          onProfileClick={() =>
            setShowProfile(false)
          }
          onLogout={handleLogout}
          activeTab={activeTab}
          onTabChange={setActiveTab}
        />

        <main className="mx-auto max-w-7xl p-4 sm:p-6 lg:p-8">
          <ProfilePage
            user={currentUser}
          />
        </main>
      </div>
    );
  }

  /*
   * برای Admin ممکن است selectedPharmacy
   * null باشد.
   *
   * Navbar فعلی Pharmacy اجباری می‌خواهد،
   * بنابراین در آن حالت یک object موقت صرفاً
   * برای UI ارسال می‌کنیم.
   */
  const navbarPharmacy =
    selectedPharmacy ??
    pharmacies[0] ??
    ({
      id: '',
      name: 'مدیریت پلتفرم',
      licenseNumber: '',
      technicalManager: '',
      city: '',
      province: '',
      address: '',
      phone: '',
      trustScore: 0,
      activeB2BExchange: false,
      avatar: '',
    } as Pharmacy);

  /*
   * محتوای اصلی
   */
  let pageContent: React.ReactNode;

  switch (activeTab) {
    case 'inventory_mgmt':
      pageContent = selectedPharmacy ? (
        <InventoryManager
          activePharmacy={
            selectedPharmacy
          }
          pharmacies={pharmacies}
          currentUser={currentUser}
          products={products}
          stockItems={visibleStockItems}
          onAddStockItem={
            handleAddStockItem
          }
          onUpdateStockItem={
            handleUpdateStockItem
          }
          onDeleteStockItem={
            handleDeleteStockItem
          }
          onPushToExchange={
            handlePushToExchange
          }
          onPharmacyChange={
            handleSelectPharmacy
          }
        />
      ) : (
        <div
          dir="rtl"
          className="rounded-2xl border border-slate-200 bg-white p-8 text-center"
        >
          <h2 className="text-lg font-black text-slate-900">
            ابتدا یک داروخانه انتخاب کنید
          </h2>

          <p className="mt-2 text-sm text-slate-500">
            برای مشاهده و مدیریت موجودی، یک داروخانه
            را انتخاب کنید.
          </p>
        </div>
      );

      break;

    case 'ai_exchange':
      pageContent = (
        <AiExchangeEngine
          matches={aiMatches}
          onSelectMatch={
            handleOpenEscrow
          }
        />
      );

      break;

    case 'escrow_payment':
      pageContent = (
        <EscrowPaymentSimulator
          selectedMatch={
            selectedMatchForEscrow
          }
          onBack={() =>
            setActiveTab('ai_exchange')
          }
        />
      );

      break;

    case 'storefront_demo':
      pageContent = (
        <StorefrontPreview
          pharmacy={
            selectedPharmacy ??
            navbarPharmacy
          }
          products={products}
          stockItems={
            visibleStockItems
          }
        />
      );

      break;

    case 'roadmap':
      pageContent = (
        <RoadmapTimeline />
      );

      break;

    case 'operational_plan':
    default:
      pageContent = (
        <OperationalPlanView
          pharmacy={
            selectedPharmacy ??
            navbarPharmacy
          }
          stockItems={
            visibleStockItems
          }
          products={products}
        />
      );

      break;
  }

  return (
    <div
      dir="rtl"
      className="min-h-screen bg-slate-50"
    >
      <Navbar
        selectedPharmacy={
          navbarPharmacy
        }
        allPharmacies={pharmacies}
        onSelectPharmacy={
          handleSelectPharmacy
        }
        currentUser={currentUser}
        onProfileClick={() =>
          setShowProfile(true)
        }
        onLogout={handleLogout}
        activeTab={activeTab}
        onTabChange={setActiveTab}
      />

      <main className="mx-auto max-w-7xl p-4 sm:p-6 lg:p-8">
        {error && (
          <div className="mb-6 flex items-start justify-between gap-4 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
            <div>
              <div className="font-black">
                خطا در دریافت اطلاعات
              </div>

              <div className="mt-1">
                {error}
              </div>
            </div>

            <button
              type="button"
              onClick={() =>
                void loadBackendData(
                  currentUser,
                )
              }
              className="shrink-0 rounded-xl bg-white px-4 py-2 text-xs font-extrabold text-rose-700 shadow-sm ring-1 ring-rose-200 transition hover:bg-rose-100"
            >
              تلاش مجدد
            </button>
          </div>
        )}

        {pageContent}
      </main>
    </div>
  );
};

export default App;